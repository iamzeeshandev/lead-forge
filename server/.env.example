# Copy this file to .env and adjust the values. .env is gitignored.

# development | test | production
NODE_ENV=development

# Port the API listens on (the client runs on 3000)
PORT=4000

# Origin allowed to call the API from the browser (no trailing slash)
CORS_ORIGIN=http://localhost:3000

# Matches the Postgres service in ../docker-compose.yml. Use 127.0.0.1, not localhost:
# localhost resolves to IPv6 ::1 first on Windows and the container only listens on IPv4.
DATABASE_URL=postgresql://leadforge:leadforge@127.0.0.1:5434/leadforge
