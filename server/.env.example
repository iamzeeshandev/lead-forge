# Copy this file to .env and adjust the values. .env is gitignored.

# development | test | production
NODE_ENV=development

# Port the API listens on (the client runs on 3000)
PORT=4000

# Origin allowed to call the API from the browser (no trailing slash)
CORS_ORIGIN=http://localhost:3000

# Matches the Postgres service in ../docker-compose.yml. Use 127.0.0.1, not localhost:
# localhost resolves to IPv6 ::1 first on Windows and the container only listens on IPv4.
DATABASE_URL=postgresql://leadforge:leadforge@127.0.0.1:5434/leadforge

# Apollo API key (Apollo → Settings → Integrations → API keys). Required. Stays on the
# server: the browser never sees it. Never commit a real key.
APOLLO_API_KEY=

# Apollo's REST API. Point it at a fake Apollo server to work without credits.
APOLLO_BASE_URL=https://api.apollo.io/api/v1

# Give up on an Apollo request after this many milliseconds.
APOLLO_TIMEOUT_MS=10000
